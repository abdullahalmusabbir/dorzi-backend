{
    "version": 2,
    "builds": [
        {
        "src": "api/index.py",
        "use": "@vercel/python"
        },
        {
        "src": "staticfiles/**",
        "use": "@vercel/static"
        }
    ],
    "buildCommand": "python manage.py collectstatic --noinput",
    "routes": [
        {
        "src": "/static/(.*)",
        "dest": "/staticfiles/$1"
        },
        {
        "src": "/(.*)",
        "dest": "api/index.py"
        }
    ]
}